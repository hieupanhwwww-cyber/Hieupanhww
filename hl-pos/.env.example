# Sao chép thành .env.local (chạy thử trên máy) hoặc dán vào phần Environment Variables của nơi chạy app.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Supabase → Project Settings → API Keys → "Publishable key" (hoặc "anon public" ở mục Legacy)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase → Project Settings → API Keys → "Secret key" (hoặc "service_role" ở mục Legacy). TUYỆT ĐỐI không chia sẻ.
SUPABASE_SERVICE_ROLE_KEY=
